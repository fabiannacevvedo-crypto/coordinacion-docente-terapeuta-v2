PORT=3001
NODE_ENV=development

# Configuracion de Base de Datos
# Por defecto utiliza SQLite para que funcione inmediatamente en cualquier maquina sin instalar MySQL.
# Si se desea MySQL, cambiar DB_DIALECT=mysql y configurar los accesos correspondientes.
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite
DB_NAME=rednec_db
DB_USER=root
DB_PASS=
DB_HOST=localhost

# Seguridad JWT
JWT_SECRET=clave_secreta_jwt_para_coordinacion_docente_terapeuta_2026
JWT_EXPIRES_IN=24h

# Cliente Frontend
FRONTEND_URL=http://localhost:5173
